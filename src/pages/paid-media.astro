---
// Solox Tek — Paid Media Management service page. Static, no framework runtime.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const tiers = [
  {
    name: 'STARTER',
    sub: '1 platform of your choice',
    price: '€1,300',
    spend: 'Ad spend up to €5,000 / mo',
    featured: false,
    features: [
      'Campaign setup and structure',
      'Audience and keyword research',
      'Ad copy for all campaigns',
      'Weekly optimization',
      'Monthly performance report',
    ],
  },
  {
    name: 'GROWTH',
    sub: '2 platforms',
    price: '€2,000',
    spend: 'Ad spend up to €15,000 / mo',
    featured: true,
    features: [
      'Everything in Starter',
      'Cross platform strategy and budget split',
      'Creative testing framework',
      'A/B testing of copy and audiences',
      'Bi weekly reporting and call',
      'Conversion tracking and pixel setup',
    ],
  },
  {
    name: 'FULL FUNNEL',
    sub: 'Google + Meta + TikTok',
    price: '€3,300',
    spend: 'Ad spend up to €30,000 / mo',
    featured: false,
    features: [
      'Everything in Growth',
      'Full funnel strategy across 3 channels',
      'Retargeting and custom audiences',
      'Landing page recommendations',
      'Weekly reporting and priority support',
      'Quarterly strategy review',
    ],
  },
];

const steps = [
  { n: '01', title: 'Audit and strategy', body: 'A free intro call, account review, and a clear plan before anything is spent.' },
  { n: '02', title: 'Setup and launch', body: 'Tracking, audiences, creatives, and campaign structure built to best practice.' },
  { n: '03', title: 'Optimize', body: 'Continuous testing of audiences, creatives, and bids against your KPIs.' },
  { n: '04', title: 'Report and scale', body: 'Transparent reporting on what was spent, what it returned, and what is next.' },
];
---
<Layout
  title="Paid Media Management · Solox Tek"
  description="Full funnel paid media management on a transparent monthly retainer. Meta, Google, and TikTok campaigns backed by 15 years in performance marketing."
  path="/paid-media/"
>
  <style is:global>
.hx1:hover{transform:translateY(-3px) !important;box-shadow:0 0 0 1px rgba(143,224,255,0.4) inset,0 22px 56px rgba(27,124,192,0.62) !important;}
.tier{transition:transform .3s ease,border-color .3s ease,box-shadow .3s ease;}
.tier:hover{transform:translateY(-4px);border-color:rgba(143,224,255,0.4) !important;box-shadow:0 30px 60px rgba(0,0,0,0.32);}
.step{transition:transform .3s ease,border-color .3s ease;}
.step:hover{transform:translateY(-3px);border-color:rgba(143,224,255,0.3) !important;}
  </style>
<div style="position:relative;background:#06121E;overflow:hidden;--sx-accent:#36A9E6;">

  <!-- aurora field -->
  <div aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;overflow:hidden;">
    <div style="position:absolute;top:-8%;left:-6%;width:52vw;height:52vw;max-width:720px;max-height:720px;border-radius:50%;background:radial-gradient(circle,rgba(54,169,230,0.30),transparent 64%);filter:blur(28px);animation:sxDrift1 21s ease-in-out infinite;"></div>
    <div style="position:absolute;top:4%;right:-10%;width:46vw;height:46vw;max-width:640px;max-height:640px;border-radius:50%;background:radial-gradient(circle,rgba(47,200,200,0.18),transparent 66%);filter:blur(32px);animation:sxDrift2 25s ease-in-out infinite;"></div>
  </div>

  <!-- blueprint grid -->
  <div aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(rgba(140,175,215,0.05) 1px,transparent 1px),linear-gradient(90deg,rgba(140,175,215,0.05) 1px,transparent 1px);background-size:54px 54px;mask-image:linear-gradient(180deg,#000,#000 72%,transparent);-webkit-mask-image:linear-gradient(180deg,#000,#000 72%,transparent);"></div>

  <!-- NAV -->
  <Nav logoHref="/" />

  <!-- HERO -->
  <header style="position:relative;z-index:2;text-align:center;padding:60px clamp(20px,5vw,48px) 40px;max-width:760px;margin:0 auto;">
    <div style="font-family:'Sora Variable',sans-serif;font-weight:600;font-size:12px;letter-spacing:0.24em;color:#8FE0FF;margin-bottom:16px;">PAID MEDIA MANAGEMENT</div>
    <h1 style="font-family:'Sora Variable',sans-serif;font-weight:300;font-size:clamp(34px,5.2vw,60px);line-height:1.06;letter-spacing:-0.035em;margin:0 0 20px;color:#F6FAFE;">Performance marketing on a <span style="font-weight:600;background:linear-gradient(110deg,#8FE0FF,var(--sx-accent) 60%,#5BC7C0);-webkit-background-clip:text;background-clip:text;color:transparent;">transparent retainer.</span></h1>
    <p style="font-family:'Manrope Variable',sans-serif;font-size:clamp(15px,1.4vw,18px);line-height:1.65;color:#AEC4DC;margin:0 auto;max-width:56ch;">Full funnel campaign management, no long term lock in. Certified across Meta, Google, and TikTok, with over 15 years in performance marketing.</p>
  </header>

  <!-- PRICING -->
  <section style="position:relative;z-index:2;padding:20px clamp(20px,5vw,48px) 20px;max-width:1080px;margin:0 auto;">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;">
      {tiers.map((t) => (
        <div class="tier" style={`display:flex;flex-direction:column;border-radius:18px;padding:28px 24px;position:relative;background:${t.featured ? 'rgba(54,169,230,0.06)' : 'rgba(255,255,255,0.03)'};border:${t.featured ? '2px solid rgba(54,169,230,0.55)' : '1px solid rgba(150,180,215,0.16)'};`}>
          {t.featured && (
            <div style="position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:linear-gradient(180deg,#36A9E6,#1B7CC0);color:#fff;font-family:'Sora Variable',sans-serif;font-weight:600;font-size:10.5px;letter-spacing:0.14em;padding:5px 14px;border-radius:999px;white-space:nowrap;">MOST POPULAR</div>
          )}
          <div style="font-family:'Sora Variable',sans-serif;font-weight:600;font-size:16px;letter-spacing:0.14em;color:#EEF4FB;">{t.name}</div>
          <div style="font-size:13px;color:#7E97B4;margin:5px 0 18px;">{t.sub}</div>
          <div style={`font-family:'Sora Variable',sans-serif;font-weight:600;font-size:38px;color:${t.featured ? '#8FE0FF' : '#F6FAFE'};line-height:1;`}>{t.price}</div>
          <div style="font-size:13px;color:#7E97B4;margin:6px 0 4px;">per month</div>
          <div style="font-size:12.5px;color:#AEC4DC;font-style:italic;margin-bottom:22px;">{t.spend}</div>
          <ul style="list-style:none;margin:0 0 24px;padding:0;display:flex;flex-direction:column;gap:11px;">
            {t.features.map((f) => (
              <li style="display:flex;gap:10px;align-items:flex-start;font-family:'Manrope Variable',sans-serif;font-size:13.5px;line-height:1.45;color:#C4D6EA;">
                <span style="color:#36A9E6;font-weight:700;flex:none;">✓</span><span>{f}</span>
              </li>
            ))}
          </ul>
          <a href="https://cal.com/solox-tek" data-cal-link="solox-tek" data-cal-config='{"layout":"month_view"}' class="hx1" style={`margin-top:auto;display:inline-flex;align-items:center;justify-content:center;padding:14px 24px;border-radius:12px;font-family:'Sora Variable',sans-serif;font-weight:600;font-size:14.5px;transition:transform .25s ease,box-shadow .25s ease;${t.featured ? 'background:linear-gradient(180deg,#36A9E6,#1B7CC0);color:#fff;box-shadow:0 0 0 1px rgba(143,224,255,0.25) inset,0 16px 44px rgba(27,124,192,0.46);' : 'background:rgba(255,255,255,0.05);color:#DCECF8;border:1px solid rgba(150,180,215,0.22);'}`}>Book a free intro call</a>
        </div>
      ))}
    </div>
    <div style="text-align:center;margin:30px auto 0;">
      <span style="display:inline-flex;flex-wrap:wrap;justify-content:center;gap:6px;font-family:'Manrope Variable',sans-serif;font-size:14px;color:#C4D6EA;background:rgba(54,169,230,0.08);border:1px solid rgba(54,169,230,0.28);border-radius:999px;padding:10px 22px;">Managing more than €30,000 a month? We build a custom plan. <a href="https://cal.com/solox-tek" data-cal-link="solox-tek" data-cal-config='{"layout":"month_view"}' style="color:#8FE0FF;font-weight:600;">Let's talk</a></span>
    </div>
    <p style="text-align:center;font-family:'Manrope Variable',sans-serif;font-size:13px;color:#7E97B4;margin:22px auto 0;max-width:70ch;line-height:1.6;">Setup and tracking implementation €450 one time, waived with a 6 month commitment. Standalone account audit with action plan €400. All prices exclude VAT where applicable. Ad spend is paid directly to the platforms and is not included in the retainer.</p>
  </section>

  <!-- HOW IT WORKS -->
  <section style="position:relative;z-index:2;padding:70px clamp(20px,5vw,48px) 40px;max-width:1080px;margin:0 auto;">
    <h2 style="font-family:'Sora Variable',sans-serif;font-weight:300;font-size:clamp(26px,3.6vw,40px);letter-spacing:-0.03em;text-align:center;margin:0 0 40px;color:#F6FAFE;">How it <span style="font-weight:600;color:#8FE0FF;">works</span></h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;">
      {steps.map((s) => (
        <div class="step" style="border:1px solid rgba(150,180,215,0.16);border-radius:16px;padding:24px 22px;background:rgba(255,255,255,0.02);">
          <div style="font-family:'Sora Variable',sans-serif;font-weight:600;font-size:26px;color:#36A9E6;margin-bottom:12px;">{s.n}</div>
          <div style="font-family:'Sora Variable',sans-serif;font-weight:600;font-size:16px;color:#EEF4FB;margin-bottom:8px;">{s.title}</div>
          <div style="font-family:'Manrope Variable',sans-serif;font-size:13.5px;line-height:1.55;color:#AEC4DC;">{s.body}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section style="position:relative;z-index:2;text-align:center;padding:40px clamp(20px,5vw,48px) 90px;max-width:720px;margin:0 auto;">
    <h2 style="font-family:'Sora Variable',sans-serif;font-weight:300;font-size:clamp(28px,4.4vw,48px);line-height:1.08;letter-spacing:-0.035em;margin:0 0 22px;color:#F6FAFE;">Let's talk about your <span style="font-weight:600;background:linear-gradient(110deg,#8FE0FF,var(--sx-accent) 60%,#5BC7C0);-webkit-background-clip:text;background-clip:text;color:transparent;">campaigns.</span></h2>
    <p style="font-family:'Manrope Variable',sans-serif;font-size:clamp(15px,1.4vw,18px);line-height:1.6;color:#AEC4DC;margin:0 auto 34px;max-width:50ch;">A free intro call and account review, with a clear plan before anything is spent.</p>
    <div style="display:flex;flex-wrap:wrap;gap:15px;justify-content:center;align-items:center;">
      <a href="https://cal.com/solox-tek" data-cal-link="solox-tek" data-cal-config='{"layout":"month_view"}' class="hx1" style="display:inline-flex;align-items:center;gap:10px;padding:17px 36px;border-radius:14px;background:linear-gradient(180deg,var(--sx-accent),#1B7CC0);color:#fff;font-family:'Sora Variable',sans-serif;font-weight:600;font-size:16.5px;box-shadow:0 0 0 1px rgba(143,224,255,0.25) inset,0 18px 50px rgba(27,124,192,0.5);transition:transform .25s ease,box-shadow .25s ease;">Book a free intro call</a>
      <span style="font-family:'Sora Variable',sans-serif;font-weight:500;font-size:13.5px;letter-spacing:0.08em;color:#7E97B4;">or <a href="mailto:contact@solox-tek.com?subject=Paid%20Media" style="color:#8FE0FF;">contact@solox-tek.com</a></span>
    </div>
  </section>

  <!-- FOOTER -->
  <Footer />

</div>
</Layout>
