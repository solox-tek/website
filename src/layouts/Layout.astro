---
// Shared page shell: head, global reset, fonts, Cal.com booking loader.
// Pages own their content, page-specific styles, scripts, and JSON-LD
// (inject extra head tags via slot="head").
import '@fontsource-variable/sora';
import '@fontsource-variable/manrope';

const { title, description, path = '/', image = '/og.png', ogType = 'website', publishedTime, modifiedTime, author } = Astro.props;
const site = 'https://solox-tek.com';
const url = site + path;
const imageUrl = site + image;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <link rel="icon" type="image/png" href="/logo-icon.png" />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Solox Tek" />
  <meta property="og:url" content={url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
  {author && <meta property="article:author" content={author} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@SoloxTek" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <slot name="head" />
  <style is:global>
*{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{margin:0;background:#06121E;color:#EEF4FB;font-family:'Manrope Variable',system-ui,sans-serif;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;}
::selection{background:rgba(54,169,230,0.32);color:#fff;}
a{color:inherit;text-decoration:none;}
@keyframes sxDrift1{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(40px,-30px) scale(1.12)}}
@keyframes sxDrift2{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(-46px,28px) scale(1.08)}}
/* FAQ open and close animation, shared by the homepage and paid media accordions.
   Native details snaps the panel open instantly while the plus icon rotates over
   250ms, and that mismatch is what reads as jarring. Matching the two fixes it.
   interpolate-size is what makes the auto keyword animatable. Browsers without
   ::details-content support fall back to the instant open, nothing breaks.

   If you verify this and conclude it does not work, check how you are clicking.
   A synthetic summary.click() from the console flips the open attribute without
   running the transition, so getComputedStyle and getAnimations both report a
   hard jump. Click it with a real mouse. */
:root{interpolate-size:allow-keywords;}
.faq details::details-content{block-size:0;overflow:hidden;transition:block-size .25s ease,content-visibility .25s allow-discrete;}
.faq details[open]::details-content{block-size:auto;}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none !important;}
  html{scroll-behavior:auto;}
  .faq details::details-content{transition:none;}
}
  </style>
</head>
<body>
<slot />
<!-- Cal.com embed: turns any [data-cal-link] element into a booking popup.
     Loaded lazily on first intent (hover/focus/touch of a CTA) with a
     post-load timeout fallback; the CTAs' href to cal.com covers clicks
     that land before the embed is ready. -->
<script is:inline>
  (function () {
    var booted = false;
    function boot() {
      if (booted) return; booted = true;
      (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; var s = d.createElement("script"); s.src = A; s.onload = function () { C.__calReady = true; }; d.head.appendChild(s); cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
      Cal("init", { origin: "https://cal.com" });
      Cal("ui", { hideEventTypeDetails: false, layout: "month_view" });
    }
    function onIntent(e) {
      if (e.target && e.target.closest && e.target.closest('[data-cal-link]')) boot();
    }
    document.addEventListener('pointerover', onIntent, { passive: true });
    document.addEventListener('focusin', onIntent);
    document.addEventListener('touchstart', onIntent, { passive: true });
    if (document.readyState === 'complete') setTimeout(boot, 3500);
    else window.addEventListener('load', function () { setTimeout(boot, 3500); });
    // Open the booking modal ourselves: the embed's own [data-cal-link]
    // binding does not intercept clicks reliably. If the embed is not
    // ready yet the CTA's href navigates to cal.com instead.
    document.addEventListener('click', function (e) {
      var el = e.target && e.target.closest && e.target.closest('[data-cal-link]');
      if (!el || e.defaultPrevented) return;
      if (!window.Cal || !window.__calReady) return;
      e.preventDefault();
      var cfg = {};
      try { cfg = JSON.parse(el.getAttribute('data-cal-config') || '{}'); } catch (err) {}
      Cal('modal', { calLink: el.getAttribute('data-cal-link'), config: cfg });
    });
  })();
</script>
</body>
</html>
