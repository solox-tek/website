---
// Shared page shell: head, global reset, fonts, Cal.com booking loader.
// Pages own their content, page-specific styles, scripts, and JSON-LD
// (inject extra head tags via slot="head").
import '@fontsource-variable/sora';
import '@fontsource-variable/manrope';

const { title, description, path = '/', image = '/og.png' } = Astro.props;
const site = 'https://solox-tek.com';
const url = site + path;
const imageUrl = site + image;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <link rel="icon" type="image/png" href="/logo-icon.png" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Solox Tek" />
  <meta property="og:url" content={url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@SoloxTek" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <slot name="head" />
  <style is:global>
*{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{margin:0;background:#06121E;color:#EEF4FB;font-family:'Manrope Variable',system-ui,sans-serif;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;}
::selection{background:rgba(54,169,230,0.32);color:#fff;}
a{color:inherit;text-decoration:none;}
@keyframes sxDrift1{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(40px,-30px) scale(1.12)}}
@keyframes sxDrift2{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(-46px,28px) scale(1.08)}}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none !important;}
  html{scroll-behavior:auto;}
}
  </style>
</head>
<body>
<slot />
<!-- Cal.com embed: turns any [data-cal-link] element into a booking popup -->
<script is:inline>
  (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
  Cal("init", { origin: "https://cal.com" });
  Cal("ui", { hideEventTypeDetails: false, layout: "month_view" });
</script>
</body>
</html>
